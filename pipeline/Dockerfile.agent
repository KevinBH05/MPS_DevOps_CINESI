FROM gocd/gocd-agent-docker-dind:v26.1.0

USER root

ARG GRADLE_VERSION=8.10.2

# JDK completo (la imagen solo trae un JRE para GoCD)
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache openjdk17 curl unzip bash; \
    else \
      apt-get update \
      && apt-get install -y --no-install-recommends openjdk-17-jdk-headless curl unzip \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Gradle con versión fija
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip \
 && unzip -q /tmp/gradle.zip -d /opt \
 && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle \
 && rm /tmp/gradle.zip

USER go