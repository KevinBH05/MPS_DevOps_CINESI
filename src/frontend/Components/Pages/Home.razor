@page "/"
@rendermode InteractiveServer
@using CineFrontend.Models

<PageTitle>Cine DevOps - Cartelera</PageTitle>

<div style="max-width: 800px; margin: 40px auto; font-family: Arial, sans-serif;">
    <h1>🎬 Cine DevOps - Compra de Entradas</h1>
    <p>Selecciona una película de la cartelera para comprar tus entradas:</p>

    <!-- 1. LISTA DE PELÍCULAS (Cartelera) -->
    <div style="display: flex; gap: 20px; margin-bottom: 30px;">
        @foreach (var peli in cartelera)
        {
            <div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; width: 30%;
                        background-color: @(peliculaSeleccionada?.Id == peli.Id ? "#e3f2fd" : "white");">
                <h3>@peli.Titulo</h3>
                <p>🕒 Horario: @peli.Horario</p>
                <p>💶 Precio: <strong>@peli.Precio €</strong></p>
                <button @onclick="() => SeleccionarPelicula(peli)" 
                        style="padding: 8px 12px; cursor: pointer;">
                    Elegir
                </button>
            </div>
        }
    </div>

    <!-- 2. FORMULARIO DE COMPRA (Solo aparece si elegiste película) -->
    @if (peliculaSeleccionada != null && !compraConfirmada)
    {
        <div style="border: 2px solid #2196F3; padding: 20px; border-radius: 8px; background: #f9f9f9;">
            <h2>Has elegido: @peliculaSeleccionada.Titulo</h2>
            
            <label>Número de entradas: </label>
            <input type="number" min="1" max="10" @bind="cantidadEntradas" style="width: 60px; padding: 5px;" />

            <p style="font-size: 1.2em; margin-top: 15px;">
                Total a pagar: <strong>@(peliculaSeleccionada.Precio * cantidadEntradas) €</strong>
            </p>

            <button @onclick="ConfirmarCompra" 
                    style="background: #4CAF50; color: white; border: none; padding: 10px 20px; font-size: 1em; cursor: pointer; border-radius: 5px;">
                Confirmar Compra
            </button>
        </div>
    }

    <!-- 3. MENSAJE DE CONFIRMACIÓN -->
    @if (compraConfirmada && peliculaSeleccionada != null)
    {
        <div style="border: 2px solid #4CAF50; padding: 20px; border-radius: 8px; background: #e8f5e9; margin-top: 20px;">
            <h2>✅ ¡Compra realizada con éxito!</h2>
            <p>Película: <strong>@peliculaSeleccionada.Titulo</strong> (@peliculaSeleccionada.Horario)</p>
            <p>Entradas: <strong>@cantidadEntradas</strong></p>
            <p>Total pagado: <strong>@(peliculaSeleccionada.Precio * cantidadEntradas) €</strong></p>
            
            <button @onclick="Reiniciar" style="margin-top: 10px; padding: 8px 12px; cursor: pointer;">
                Comprar otra entrada
            </button>
        </div>
    }
</div>

@code {
    // Datos simulados (Mock) hasta que el backend esté listo
    private List<Pelicula> cartelera = new()
    {
        new Pelicula { Id = 1, Titulo = "Dune: Parte Dos", Horario = "18:00", Precio = 8.50m },
        new Pelicula { Id = 2, Titulo = "Oppenheimer", Horario = "20:30", Precio = 9.00m },
        new Pelicula { Id = 3, Titulo = "Spider-Man", Horario = "22:00", Precio = 7.50m }
    };

    private Pelicula? peliculaSeleccionada;
    private int cantidadEntradas = 1;
    private bool compraConfirmada = false;

    private void SeleccionarPelicula(Pelicula peli)
    {
        peliculaSeleccionada = peli;
        cantidadEntradas = 1;
        compraConfirmada = false;
    }

    private void ConfirmarCompra()
    {
        if (cantidadEntradas > 0)
        {
            compraConfirmada = true;
        }
    }

    private void Reiniciar()
    {
        peliculaSeleccionada = null;
        cantidadEntradas = 1;
        compraConfirmada = false;
    }
}