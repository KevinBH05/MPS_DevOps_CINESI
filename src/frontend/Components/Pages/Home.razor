@page "/"
@rendermode InteractiveServer
@using CineSi

<PageTitle>CinESI - Cartelera</PageTitle>

<div class="fondo-cine">
    <div class="contenedor-principal">
        <h1 class="titulo-principal">🎬 CinESI - Cartelera y Sesiones</h1>
        <p>Selecciona una sesión para elegir tus butacas:</p>

        <!-- 1. LISTADO DE SESIONES -->
        <div class="grid-sesiones">
            @foreach (var sesion in sesionesDisponibles)
            {
                var esSeleccionada = sesionSeleccionada?.Id == sesion.Id;
                var posterUrl = postersPorPeliculaId.GetValueOrDefault(sesion.Pelicula.Id, "");

                <div class="tarjeta-sesion @(esSeleccionada ? "seleccionada" : "")">
                    @if (!string.IsNullOrEmpty(posterUrl))
                    {
                        <img src="@posterUrl" alt="@sesion.Pelicula.Titulo" class="poster-pelicula" />
                    }
                    <h3>@sesion.Pelicula.Titulo</h3>
                    <p class="meta-pelicula">
                        🎭 @sesion.Pelicula.Genero | ⏱️ @sesion.Pelicula.DuracionMin min | 🔞 +@sesion.Pelicula.EdadMinima
                    </p>
                    <hr style="border: 0; border-top: 1px solid rgba(244, 255, 0, 0.25);" />
                    <p>🏛️ <strong>Sala @sesion.Sala.Id</strong> (@sesion.Sala.Capacidad() butacas)</p>
                    <p>🕒 Hora: <strong>@sesion.Inicio.ToString("HH:mm") - @sesion.Fin().ToString("HH:mm")</strong></p>
                    <p>💶 Tarifa base: <strong>@Entrada.PrecioBase.ToString("0.00") €</strong></p>
                    
                    <button class="boton-elegir" @onclick="() => SeleccionarSesion(sesion)">
                        Seleccionar Sesión
                    </button>
                </div>
            }
        </div>

        <!-- 2. MAPA DE BUTACAS Y DESCUENTOS -->
        @if (sesionSeleccionada != null && ticketsEmitidos == null)
        {
            <div class="panel-neon">
                <h2>Butacas para @sesionSeleccionada.Pelicula.Titulo (@sesionSeleccionada.Inicio.ToString("HH:mm"))</h2>
                
                <div style="display: flex; gap: 15px; font-size: 0.9em; margin-bottom: 15px; font-weight: bold;">
                    <span>🟩 Libre</span>
                    <span>🟦 Seleccionada</span>
                    <span>🟥 Vendida</span>
                    <span>♿ Movilidad reducida</span>
                </div>

                <div class="pantalla-cine">PANTALLA</div>

                <!-- Cuadrícula real de la Sala (Grande 10x20 o Pequeña 5x10) -->
                <div style="display: flex; flex-direction: column; gap: 6px; align-items: center; margin-bottom: 25px; overflow-x: auto;">
                    @foreach (var fila in sesionSeleccionada.ObtenerMapa().GroupBy(a => a.Asiento.Fila))
                    {
                        <div style="display: flex; gap: 4px; align-items: center;">
                            <strong style="width: 20px;">@fila.Key</strong>
                            @foreach (var asientoSesion in fila)
                            {
                                var estaSeleccionada = entradasSeleccionadas.Any(e => e.AsientoSesion == asientoSesion);
                                <button @onclick="() => AlternarAsiento(asientoSesion)"
                                        disabled="@(asientoSesion.Estado == EstadoAsiento.Vendido)"
                                        title="@asientoSesion.Asiento.Etiqueta() (@asientoSesion.Asiento.Tipo)"
                                        style="min-width: 38px; height: 32px; padding: 0 3px; font-size: 0.75em; border-radius: 5px; border: 1.5px solid #2b0f4c; font-weight: bold;
                                               cursor: @(asientoSesion.Estado == EstadoAsiento.Vendido ? "not-allowed" : "pointer");
                                               background-color: @ObtenerColorAsiento(asientoSesion, estaSeleccionada); color: #1a0633;">
                                    @asientoSesion.Asiento.Etiqueta()@(asientoSesion.Asiento.EsMinusvalido() ? "♿" : "")
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (entradasSeleccionadas.Any())
                {
                    <h3>Tus entradas seleccionadas:</h3>
                    <ul style="list-style: none; padding: 0;">
                        @foreach (var item in entradasSeleccionadas)
                        {
                            <li class="item-entrada">
                                <span>
                                    🎟️ Butaca <strong>@item.AsientoSesion.Asiento.Etiqueta()</strong> 
                                    (@(item.AsientoSesion.Asiento.EsMinusvalido() ? "Movilidad Reducida" : "Estándar"))
                                </span>
                                
                                <div>
                                    <label>Tarifa: </label>
                                    <select @bind="item.TipoDescuento" style="padding: 5px; border-radius: 4px; background-color: #160926; color: #f4ff00; border: 1px solid #f4ff00;">
                                        <option value="Normal">Normal (0% dto.)</option>
                                        <option value="Estudiante">Estudiante (-25%)</option>
                                        <option value="Senior">Senior (-40%)</option>
                                        <option value="Espectador">Día del Espectador (-50%)</option>
                                    </select>
                                    <strong style="margin-left: 15px;">@CrearEstrategia(item.TipoDescuento).Calcular(Entrada.PrecioBase).ToString("0.00") €</strong>
                                </div>
                            </li>
                        }
                    </ul>

                    <!-- [AQUÍ IRÁ EN EL FUTURO LA OPCIÓN DE PALOMITAS] -->

                    <p style="font-size: 1.3em; text-align: right; margin-top: 15px;">
                        Total a pagar: <strong>@CalcularTotalCompra().ToString("0.00") €</strong>
                    </p>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <p style="color: #ff5252; font-weight: bold; text-align: right;">⚠️ @mensajeError</p>
                    }

                    <div style="text-align: right;">
                        <button class="boton-confirmar" @onclick="ConfirmarCompra">
                            Confirmar Compra (@entradasSeleccionadas.Count entradas)
                        </button>
                    </div>
                }
            </div>
        }

        <!-- 3. TICKETS REALES EMITIDOS POR EL BACKEND -->
        @if (ticketsEmitidos != null && sesionSeleccionada != null)
        {
            <div class="panel-neon">
                <h2>✅ ¡Compra confirmada! Tus tickets oficiales:</h2>
                <ul style="list-style: none; padding: 0;">
                    @foreach (var t in ticketsEmitidos)
                    {
                        <li class="item-entrada">
                            <span>
                                🎫 <strong>Ticket #@t.Codigo</strong> — @t.Pelicula() | Sala @t.Sala() | @t.Hora().ToString("dd/MM HH:mm") | Butaca <strong>@t.Asiento()</strong>
                            </span>
                            <strong>@t.PrecioPagado.ToString("0.00") €</strong>
                        </li>
                    }
                </ul>
                <p style="font-size: 1.2em; text-align: right;">
                    <strong>Total pagado:</strong> @ticketsEmitidos.Sum(t => t.PrecioPagado).ToString("0.00") €
                </p>

                <button class="boton-confirmar" @onclick="Reiniciar" style="margin-top: 10px;">
                    Volver a la cartelera
                </button>
            </div>
        }
    </div>
</div>

@code {
    private class EntradaBorrador
    {
        public AsientoSesion AsientoSesion { get; set; } = default!;
        public string TipoDescuento { get; set; } = "Normal";
    }

    // Diccionario para asociar tus imágenes a los IDs de las películas del backend
    private Dictionary<int, string> postersPorPeliculaId = new()
    {
        { 1, "https://lumiere-a.akamaihd.net/v1/images/captura_de_pantalla_2026-07-20_a_la_s_5_65bfa234.png?region=0,0,1144,1628" },
        { 2, "https://m.media-amazon.com/images/I/61FdpB2M6PL._AC_UF894,1000_QL80_.jpg" },
        { 3, "https://ih1.redbubble.net/image.2357228583.8271/flat,750x,075,f-pad,750x1000,f8f8f8.jpg" }
    };

    private List<Sesion> sesionesDisponibles = new();
    private Sesion? sesionSeleccionada;
    private List<EntradaBorrador> entradasSeleccionadas = new();
    private List<Ticket>? ticketsEmitidos;
    private string? mensajeError;

    // Se ejecuta al cargar la página: creamos las salas y sesiones usando las Factories del backend
    protected override void OnInitialized()
    {
        ISalaFactory salaGrande = new SalaGrandeFactory();
        ISalaFactory salaPequena = new SalaPequenaFactory();

        var peli1 = new Pelicula(1, "Avengers: Doomsday", 165, "Ciencia Ficción", 12);
        var peli2 = new Pelicula(2, "Pesadilla antes de Navidad", 76, "Fantasía", 3);
        var peli3 = new Pelicula(3, "Klaus", 96, "Comedia", 3);

        var sesion1 = new Sesion(1, DateTime.Today.AddHours(18), salaGrande.CrearSala(), peli1);
        var sesion2 = new Sesion(2, DateTime.Today.AddHours(20).AddMinutes(30), salaPequena.CrearSala(), peli2);
        var sesion3 = new Sesion(3, DateTime.Today.AddHours(22), salaPequena.CrearSala(), peli3);

        // Simulamos un par de asientos ya vendidos en la sesión 1 para probar
        var b3 = sesion1.Sala.ObtenerAsiento('B', 3);
        sesion1.BloquearAsientos(new[] { b3 }, clienteId: 99);
        var compraPrevia = new Compra(99, sesion1);
        compraPrevia.AgregarEntrada(sesion1.ObtenerAsientoSesion(b3), new SinDescuento());
        compraPrevia.Confirmar();

        sesionesDisponibles = new() { sesion1, sesion2, sesion3 };
    }

    private void SeleccionarSesion(Sesion sesion)
    {
        sesionSeleccionada = sesion;
        ticketsEmitidos = null;
        mensajeError = null;
        entradasSeleccionadas.Clear();
    }

    private void AlternarAsiento(AsientoSesion asientoSesion)
    {
        if (asientoSesion.Estado == EstadoAsiento.Vendido) return;

        var existente = entradasSeleccionadas.FirstOrDefault(e => e.AsientoSesion == asientoSesion);
        if (existente != null)
        {
            entradasSeleccionadas.Remove(existente);
        }
        else if (asientoSesion.Estado == EstadoAsiento.Libre)
        {
            entradasSeleccionadas.Add(new EntradaBorrador { AsientoSesion = asientoSesion });
        }
    }

    private string ObtenerColorAsiento(AsientoSesion asientoSesion, bool estaSeleccionada)
    {
        if (estaSeleccionada) return "#40c4ff"; // Azul cian (seleccionada por ti)
        return asientoSesion.Estado switch
        {
            EstadoAsiento.Libre => "#69f0ae",      // Verde brillante
            EstadoAsiento.Bloqueado => "#ffd740",  // Ámbar (bloqueado por otro)
            EstadoAsiento.Vendido => "#ff5252",    // Rojo coral
            _ => "white"
        };
    }

    private IDescuentoStrategy CrearEstrategia(string tipo) => tipo switch
    {
        "Estudiante" => new DescuentoEstudiante(),
        "Senior" => new DescuentoSenior(),
        "Espectador" => new DescuentoDiaEspectador(),
        _ => new SinDescuento()
    };

    private decimal CalcularTotalCompra() =>
        entradasSeleccionadas.Sum(e => CrearEstrategia(e.TipoDescuento).Calcular(Entrada.PrecioBase));

    private void ConfirmarCompra()
    {
        if (sesionSeleccionada == null || !entradasSeleccionadas.Any()) return;

        try
        {
            mensajeError = null;
            int clienteId = 1;

            // 1. Bloqueamos los asientos en la sesión real
            var asientosFisicos = entradasSeleccionadas.Select(e => e.AsientoSesion.Asiento);
            sesionSeleccionada.BloquearAsientos(asientosFisicos, clienteId);

            // 2. Creamos la Compra real y agregamos cada entrada con su Strategy
            var compra = new Compra(clienteId, sesionSeleccionada);
            foreach (var item in entradasSeleccionadas)
            {
                var estrategia = CrearEstrategia(item.TipoDescuento);
                compra.AgregarEntrada(item.AsientoSesion, estrategia);
            }

            // 3. Confirmamos y emitimos los tickets oficiales
            compra.Confirmar();
            ticketsEmitidos = compra.EmitirTickets().ToList();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void Reiniciar()
    {
        sesionSeleccionada = null;
        entradasSeleccionadas.Clear();
        ticketsEmitidos = null;
        mensajeError = null;
    }
}